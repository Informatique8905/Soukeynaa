# ===== Base de données =====
# PostgreSQL — format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Exemples : local (npx prisma dev) ou hébergé (Neon, Supabase, VPS)
DATABASE_URL="postgresql://user:password@localhost:5432/soukeyna?schema=public"

# ===== Authentification (Auth.js) =====
# Générer avec : npx auth secret
AUTH_SECRET=
# URL de l'application (http://localhost:3000 en dev)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ===== Paiement Jèko =====
# Clés API Jèko (sandbox en dev, production en prod) — jamais exposées côté client
JEKO_API_KEY=
JEKO_API_SECRET=
# Secret utilisé pour vérifier la signature du webhook Jèko
JEKO_WEBHOOK_SECRET=
# URL de base de l'API Jèko (sandbox / production)
JEKO_API_BASE_URL=
JEKO_STORE_ID=

# ===== Images Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Emails (Resend ou Brevo) =====
# Resend
RESEND_API_KEY=
# Brevo (alternative)
BREVO_API_KEY=
# Adresse d'expédition vérifiée auprès du service
EMAIL_FROM="SOUKEYNA <commandes@exemple.ci>"
# Email de l'administrateur (alertes nouvelle commande / anomalie de paiement)
ADMIN_EMAIL=

# ===== Tâches planifiées =====
# Secret Bearer des routes /api/cron/* (expiration réservations, réconciliation)
CRON_SECRET=

# ===== Paramètres métier =====
# Durée de réservation du stock en minutes (section 5.8)
STOCK_RESERVATION_MINUTES=30
# Devise affichée
NEXT_PUBLIC_CURRENCY=FCFA
# Contact boutique affiché (téléphone / WhatsApp) — sections 7.8 et 9.7
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_WHATSAPP=

# ===== Seed =====
# Compte administrateur initial créé par `npx prisma db seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
